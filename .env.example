# Copy to .env and fill in. .env is gitignored.

# Supabase project settings -> API. Safe to be public: these ship in the
# built bundle regardless, and row-level security is the actual protection,
# not secrecy of this key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Skip the real sign-in flow during local dev - no magic-link email needed.
# Charts save to browser storage, never Supabase, and there's no account to
# sign in to. Only has any effect for `vite dev`; `vite build` hardcodes this
# to false, so the bypassed session state can never occur in a deployed
# build, regardless of this file's contents.
VITE_DEV_SKIP_AUTH=false

# Only needed to run scripts/sync-symbols.py (pulling the stitch library from
# Figma). Never gets a VITE_ prefix and must never reach a build step — on a
# public repo that would publish it in the bundle.
FIGMA_TOKEN=
